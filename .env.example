# =====================================================================
# CONFIGURAÇÕES DO WHATSAPP INSIGHTS LLM
# =====================================================================

# Provedor de Inteligência Artificial: Anthropic (Claude)
# Obtenha sua chave em: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo padrão do Claude (opções: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Banco de Dados em Nuvem: Neon (PostgreSQL Serverless)
# Deixe em branco para usar SQLite local em data/messages.db
# Exemplo Neon: postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Configurações do Servidor Web
HOST=127.0.0.1
PORT=8000
